{
  "name": "voicevox-contribution-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/createPagesFallback.ts",
    "fetch-data": "node scripts/fetchGithubData.ts",
    "lint": "eslint src scripts tests vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
